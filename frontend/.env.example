# Copy to frontend/.env.local for local overrides (git-ignored).
# Only variables prefixed with VITE_ are exposed to browser code -
# never put secrets in them.

# Where the browser sends API requests.
#   Development: keep "/api" (proxied by Vite to XAMPP, see below).
#   Production:  the public path of the PHP API, e.g. "/api".
VITE_API_BASE_URL=/api

# Public path the built frontend is served from (production build only).
#   Domain root: "/"   |   XAMPP build preview: "/Holcim/frontend/dist/"
VITE_BASE_PATH=/

# Development only (NOT exposed to the browser): where Vite forwards /api.
# Matches the default XAMPP location htdocs/Holcim/backend.
DEV_API_PROXY_TARGET=http://localhost/Holcim/backend
