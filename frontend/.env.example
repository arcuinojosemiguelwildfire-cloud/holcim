# Copy to frontend/.env.local for local overrides (git-ignored).
# Only variables prefixed with VITE_ are exposed to browser code -
# never put secrets in them.

# Where the browser sends API requests.
#   Development: keep "/api" (proxied by Vite to XAMPP, see below).
#   Production:  the public path of the PHP API, e.g. "/api".
VITE_API_BASE_URL=/api

# Public path the built frontend is served from (production build only).
#   Domain root: "/"   |   XAMPP build preview: "/Holcim/frontend/dist/"
VITE_BASE_PATH=/

# Development only (NOT exposed to the browser): where Vite forwards /api.
# Matches the default XAMPP location htdocs/Holcim/backend.
DEV_API_PROXY_TARGET=http://localhost/Holcim/backend

# --- Supabase (migration Phase 1: configured, not used by the app yet) -------
# Project Settings > API in the Supabase dashboard. Both values are PUBLIC.
#   VITE_SUPABASE_URL       https://<project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY  the "anon" (legacy) or "sb_publishable_..." key
# NEVER put the service_role / sb_secret_ key here, in Vercel or in Git:
# it bypasses Row Level Security. It belongs only in Supabase Edge Function
# secrets. The build refuses to run if a secret key is found in VITE_ vars.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Phase 2 (Supabase Auth, not used by the app yet): internal email domain for
# scanner-operator USERNAME logins ("gate-1" signs in as gate-1@<domain>). Public,
# not a secret; must be a domain that never receives mail. Default:
# scanner.holcim-event.invalid
VITE_SUPABASE_USERNAME_EMAIL_DOMAIN=
