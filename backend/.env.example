# ---------------------------------------------------------------------------
# Holcim Event System - LOCAL (XAMPP) configuration template
#
# Copy to backend/.env and adjust. backend/.env is git-ignored: never commit it.
# For production values see backend/.env.production.example.
# ---------------------------------------------------------------------------

APP_NAME="Holcim Event System"
APP_ENV=local
# true shows exception messages in API errors. NEVER true in production.
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila

# Public base URL (no trailing slash). Attendee QR codes contain {APP_URL}/q/{token}.
# Set the real production URL BEFORE printing QR codes. Empty = QR holds the token only.
APP_URL=http://localhost:5173

# XAMPP MySQL/MariaDB defaults: user "root" with an empty password.
# Prefer a dedicated user even locally (see README > MySQL database setup).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=holcim_event
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=holcim_session
# Idle timeout in seconds (28800 = 8 hours)
SESSION_LIFETIME=28800
SESSION_PATH=/
SESSION_DOMAIN=
# http://localhost has no HTTPS, so secure cookies must be off locally.
SESSION_SECURE_COOKIE=false
SESSION_SAMESITE=Lax

# Only needed if the frontend is served from a DIFFERENT origin than the API
# (the Vite dev proxy makes this unnecessary). Comma-separated.
CORS_ALLOWED_ORIGINS=
