# ---------------------------------------------------------------------------
# Holcim Event System - PRODUCTION configuration template
#
# On the server, save as backend/.env (outside version control) OR set these as
# real environment variables in the hosting panel / Apache SetEnv. Real
# environment variables take precedence over the .env file.
# ---------------------------------------------------------------------------

APP_NAME="Holcim Event System"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila

# Public base URL (no trailing slash). Attendee QR codes contain {APP_URL}/q/{token}.
# Set the real production URL BEFORE printing QR codes. Empty = QR holds the token only.
APP_URL=https://CHANGE_ME.example.com

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Login brute-force protection (failed attempts per email / per IP within the lockout window)
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_LOCKOUT_MINUTES=15

SESSION_NAME=holcim_session
SESSION_LIFETIME=28800
SESSION_PATH=/
SESSION_DOMAIN=
# Production MUST run on HTTPS with secure cookies.
SESSION_SECURE_COOKIE=true
SESSION_SAMESITE=Lax

# Leave empty when the frontend and API share one domain (recommended).
CORS_ALLOWED_ORIGINS=
