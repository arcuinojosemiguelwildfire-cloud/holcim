{
  "name": "holcim-migration-tools",
  "private": true,
  "type": "module",
  "description": "MySQL -> Supabase PostgreSQL import and read-only QR migration verification (Node 22.18+, TypeScript run directly).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "verify-qr": "node verify-qr-migration.ts",
    "import": "node import-mysql-to-postgres.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "mysql2": "^3.24.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
